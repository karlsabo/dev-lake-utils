CREATE TABLE worktree_archive_jobs (
  worktree_path TEXT NOT NULL PRIMARY KEY,
  repository_root_path TEXT NOT NULL,
  branch TEXT NOT NULL,
  queue_id TEXT NOT NULL,
  lifecycle_state TEXT NOT NULL,
  queued_at_epoch_ms INTEGER NOT NULL,
  state_updated_at_epoch_ms INTEGER NOT NULL,
  deadline_at_epoch_ms INTEGER NOT NULL,
  error_message TEXT
);

selectAll:
SELECT
  worktree_path,
  repository_root_path,
  branch,
  queue_id,
  lifecycle_state,
  queued_at_epoch_ms,
  state_updated_at_epoch_ms,
  deadline_at_epoch_ms,
  error_message
FROM worktree_archive_jobs
ORDER BY queued_at_epoch_ms, worktree_path;

upsertJob:
INSERT OR REPLACE INTO worktree_archive_jobs(
  worktree_path,
  repository_root_path,
  branch,
  queue_id,
  lifecycle_state,
  queued_at_epoch_ms,
  state_updated_at_epoch_ms,
  deadline_at_epoch_ms,
  error_message
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertQueuedJob:
INSERT OR IGNORE INTO worktree_archive_jobs(
  worktree_path, repository_root_path, branch, queue_id, lifecycle_state,
  queued_at_epoch_ms, state_updated_at_epoch_ms, deadline_at_epoch_ms, error_message
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

transitionQueuedJobToRemoving:
UPDATE worktree_archive_jobs
SET lifecycle_state = 'REMOVING', state_updated_at_epoch_ms = ?, error_message = NULL
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'QUEUED';

deleteQueuedJob:
DELETE FROM worktree_archive_jobs
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'QUEUED';

deleteRemovingJob:
DELETE FROM worktree_archive_jobs
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'REMOVING';

transitionRemovingJobToFailed:
UPDATE worktree_archive_jobs
SET lifecycle_state = 'FAILED', state_updated_at_epoch_ms = ?, error_message = ?
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'REMOVING' AND state_updated_at_epoch_ms = ?;

transitionFailedJobToRemoving:
UPDATE worktree_archive_jobs
SET lifecycle_state = 'REMOVING', state_updated_at_epoch_ms = ?, error_message = NULL
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'FAILED' AND state_updated_at_epoch_ms = ?;

deleteFailedJob:
DELETE FROM worktree_archive_jobs
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'FAILED' AND state_updated_at_epoch_ms = ?;

transitionRemovingJobToNeedsForceConfirmation:
UPDATE worktree_archive_jobs
SET lifecycle_state = 'NEEDS_FORCE_CONFIRMATION', state_updated_at_epoch_ms = ?, error_message = ?
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'REMOVING' AND state_updated_at_epoch_ms = ?;

transitionNeedsForceConfirmationJobToRemoving:
UPDATE worktree_archive_jobs
SET lifecycle_state = 'REMOVING', state_updated_at_epoch_ms = ?, error_message = NULL
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'NEEDS_FORCE_CONFIRMATION' AND state_updated_at_epoch_ms = ?;

restoreQueuedJob:
UPDATE worktree_archive_jobs
SET lifecycle_state = ?, state_updated_at_epoch_ms = ?, deadline_at_epoch_ms = ?, error_message = ?
WHERE worktree_path = ? AND queue_id = ? AND lifecycle_state = 'QUEUED' AND state_updated_at_epoch_ms = ?;

changedRowCount:
SELECT changes();
